---
import { siteConfig } from '@/config/site';
import { headerNav, footerNav } from '@/data/navigation';
import { getSupportedLanguage, supportedLanguages } from '@/data/localization';
import { categories } from '@/data/categories';
import { resolveCanonicalUrl } from '@/lib/search-canonical';
import { buildSchemas } from '@/lib/search-schema';
import { getHreflangAlternates } from '@/lib/search-hreflang';
import { buildMetadata } from '@/lib/search-metadata';
import { getImageMetadata } from '@/lib/search-image-seo';
import CommandPalette from '@/components/CommandPalette.astro';
import PwaInstallBanner from '@/components/PwaInstallBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  alternates?: { lang: string; href: string }[];
}

const { title, description, canonical, ogImage, schema = [], noindex = false, lang = 'en', dir = 'ltr', alternates = [] } = Astro.props;
const canonicalUrl = resolveCanonicalUrl(canonical || Astro.url.pathname);
const ogImg = ogImage || `${siteConfig.url}${siteConfig.defaultOgImage}`;

const meta = buildMetadata({
  pathname: Astro.url.pathname,
  lang,
  titleOverride: title,
  descriptionOverride: description,
  noindexOverride: noindex
});

const imageMeta = getImageMetadata(ogImage || siteConfig.defaultOgImage, 'general');

const allSchemas = buildSchemas({
  pathname: Astro.url.pathname,
  lang,
  title: meta.title,
  description: meta.description,
  customSchemas: [...schema, imageMeta.schema]
});
const hreflangs = getHreflangAlternates(Astro.url.pathname);
const altList = (alternates && alternates.length > 0) ? alternates : hreflangs;
const altMap = new Map<string, string>();
altList.forEach(alt => {
  if (alt.lang !== 'x-default') {
    altMap.set(alt.lang, alt.href.replace(siteConfig.url, ''));
  }
});

const allLanguageItems = supportedLanguages.map(l => {
  let targetHref = altMap.get(l.code);
  if (!targetHref) {
    targetHref = l.code === 'en' ? '/' : `/${l.code}/`;
  }
  return {
    code: l.code,
    nativeName: l.nativeName,
    href: targetHref,
    isActive: l.code === lang
  };
});

const currentPath = Astro.url.pathname;
const isSpanish = lang === 'es';
const navLabelMap: Record<string, string> = {
  '/': 'Inicio',
  '/tools/': 'Herramientas',
  '/categories/': 'Categorías',
  '/blog/': 'Blog',
  '/about-us/': 'Acerca de',
};
const footerLabelMap: Record<string, string> = {
  '/tools/name-generators/': 'Generadores de nombres',
  '/tools/text-generators/': 'Generadores de texto',
  '/tools/writing-generators/': 'Generadores de escritura',
  '/tools/seo-generators/': 'Generadores SEO',
  '/tools/business-generators/': 'Generadores para negocios',
  '/tools/creative-generators/': 'Generadores creativos',
  '/tools/fancy-text-generator/': 'Generador de letras bonitas',
  '/tools/name-generator/': 'Generador de nombres',
  '/tools/username-generator/': 'Generador de nombres de usuario',
  '/tools/bio-generator/': 'Generador de biografías',
  '/tools/youtube-tag-generator/': 'Generador de etiquetas para videos',
  '/tools/business-name-generator/': 'Generador de nombres para empresas',
  '/about-us/': 'Acerca de',
  '/contact-us/': 'Contacto',
  '/privacy/': 'Privacidad',
  '/terms/': 'Términos',
  '/disclaimer/': 'Aviso legal',
  '/sitemap/': 'Mapa del sitio',
};
const localizeLabel = (href: string, label: string) => isSpanish ? (footerLabelMap[href] || navLabelMap[href] || label) : label;
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <!-- Performance: DNS prefetch for third-party origins -->
  <link rel="dns-prefetch" href="//fonts.googleapis.com" />
  <link rel="dns-prefetch" href="//fonts.gstatic.com" />
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />
  <!-- Non-blocking Google Fonts: only weights actually used in CSS -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" /></noscript>
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  <link rel="canonical" href={meta.canonical} />
  {hreflangs.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
  ))}
  <meta name="robots" content={meta.robots} />
  <meta name="googlebot" content={meta.robots} />
  
  <meta name="author" content={meta.author} />
  <meta name="application-name" content={meta.applicationName} />
  <meta name="generator" content={meta.generator} />
  <meta name="creator" content={meta.creator} />
  <meta name="publisher" content={meta.publisher} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:url" content={meta.canonical} />
  <meta property="og:site_name" content={siteConfig.name} />
  <meta property="og:image" content={imageMeta.url} />
  <meta property="og:image:width" content={imageMeta.width.toString()} />
  <meta property="og:image:height" content={imageMeta.height.toString()} />
  <meta property="og:image:type" content={imageMeta.mimeType} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={meta.title} />
  <meta name="twitter:description" content={meta.description} />
  <meta name="twitter:image" content={imageMeta.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="TapToGen" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {siteConfig.verification.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
  {siteConfig.verification.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-RRXK1L32WK"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-RRXK1L32WK', {
      anonymize_ip: true,
      send_page_view: true
    });
  </script>
  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <style is:global>
    @import '../styles/global.css';
    
    /* First-class Navigation Dropdown Styles */
    .nav-item-dropdown {
      position: relative;
      display: inline-block;
    }
    
    .nav-dropdown-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--color-text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: var(--transition);
      line-height: inherit;
      border-radius: 8px;
    }
    
    .nav-dropdown-toggle:hover,
    .nav-item-dropdown:hover .nav-dropdown-toggle,
    .nav-dropdown-toggle:focus-visible {
      color: var(--color-text-primary);
      background: rgba(108,92,231,0.1);
      outline: none;
    }
    
    .dropdown-chevron {
      font-size: 8px;
      margin-left: 2px;
      opacity: 0.7;
      transition: transform 0.2s;
    }
    
    .nav-item-dropdown:hover .dropdown-chevron,
    .nav-item-dropdown.mobile-open .dropdown-chevron {
      transform: rotate(180deg);
    }
    
    .nav-dropdown-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 50%;
      transform: translateX(-50%) translateY(4px);
      background-color: rgba(10, 10, 30, 0.98);
      backdrop-filter: blur(20px);
      min-width: 220px;
      max-height: 400px;
      overflow-y: auto;
      border-radius: 12px;
      padding: 6px;
      margin: 0;
      list-style: none;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(108,92,231,0.15);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
      z-index: 1000;
      border: 1px solid rgba(108,92,231,0.15);
    }

    .category-dropdown-menu {
      min-width: 260px;
    }
    
    .nav-item-dropdown:hover .nav-dropdown-menu,
    .nav-item-dropdown:focus-within .nav-dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
    
    .nav-dropdown-menu li {
      margin: 0;
      padding: 0;
    }
    
    .nav-dropdown-menu a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      font-size: 0.88rem;
      color: var(--color-text-secondary);
      text-decoration: none;
      font-weight: 500;
      transition: background-color 0.15s, color 0.15s;
      border: none;
      background: transparent;
      text-align: left;
      border-radius: 8px;
    }
    
    .nav-dropdown-menu a:hover,
    .nav-dropdown-menu a:focus-visible {
      background-color: rgba(108,92,231,0.12);
      color: var(--color-text-primary);
      outline: none;
    }
    
    .nav-dropdown-menu a.active-lang {
      color: var(--color-accent-2);
      background: rgba(168,85,247,0.1);
      font-weight: 600;
    }
    
    .lang-check {
      font-size: 12px;
      font-weight: bold;
      color: var(--primary-color, #4f46e5);
    }

    .nav-search-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(108, 92, 231, 0.08);
      border: 1px solid rgba(108, 92, 231, 0.2);
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      transition: var(--transition);
    }

    .nav-search-btn:hover,
    .nav-search-btn:focus-visible {
      background: rgba(108, 92, 231, 0.18);
      color: var(--color-text-primary);
      border-color: var(--color-primary);
      outline: none;
    }

    .nav-kbd {
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--color-text-secondary);
      font-family: inherit;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    .footer-grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }

    @media (max-width: 768px) {
      .nav-item-dropdown {
        display: block;
        width: 100%;
      }
      
      .nav-dropdown-toggle {
        width: 100%;
        padding: 12px 16px;
        justify-content: space-between;
        font-size: 0.95rem;
      }
      
      .nav-dropdown-menu {
        position: static;
        transform: none;
        background-color: rgba(108,92,231,0.06);
        backdrop-filter: none;
        box-shadow: none;
        border: none;
        width: 100%;
        max-height: 0;
        overflow: hidden;
        padding: 0;
        opacity: 1;
        visibility: visible;
        transition: max-height 0.3s ease-out;
        border-radius: 8px;
        margin-top: 4px;
      }
      
      .nav-item-dropdown:hover .nav-dropdown-menu,
      .nav-item-dropdown:focus-within .nav-dropdown-menu,
      .nav-item-dropdown.mobile-open .nav-dropdown-menu {
        max-height: 70vh;
        overflow-y: auto;
        padding: 4px;
      }
      
      .nav-dropdown-menu a {
        padding: 10px 16px;
        color: var(--color-text-secondary);
        border-radius: 6px;
      }
      
      .nav-dropdown-menu a:hover {
        background-color: rgba(108,92,231,0.1);
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .footer-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <!-- Header -->
  <nav class="nav" id="main-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <span class="logo-icon">⚡</span>
        {siteConfig.name}
      </a>
      <div class="nav-links" id="nav-links" role="navigation" aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}>
        <a href="/" class={currentPath === '/' ? 'active' : ''}>{localizeLabel('/', 'Home')}</a>
        <a href="/tools/" class={currentPath === '/tools/' || (currentPath.startsWith('/tools/') && currentPath !== '/tools/categories/') ? 'active' : ''}>{localizeLabel('/tools/', 'Tools')}</a>
        
        {/* CATEGORIES DROPDOWN */}
        <div class="nav-item-dropdown" id="categories-dropdown">
          <button 
            class="nav-dropdown-toggle" 
            aria-haspopup="true" 
            aria-expanded="false"
            aria-label="Explore Categories"
          >
            <span>{localizeLabel('/categories/', 'Categories')}</span>
            <span class="dropdown-chevron" aria-hidden="true">▼</span>
          </button>
          <ul class="nav-dropdown-menu category-dropdown-menu" role="menu" aria-label="Categories">
            <li role="none">
              <a href="/categories/" role="menuitem" style="font-weight: 600; border-bottom: 1px solid var(--color-border); margin-bottom: 4px;">
                <span>📂 All Categories</span>
                <span>&rarr;</span>
              </a>
            </li>
            {categories.map((c) => (
              <li role="none">
                <a href={`/categories/${c.slug}/`} role="menuitem">
                  <span style="display: flex; align-items: center; gap: 8px;">
                    <span>{c.icon}</span>
                    <span>{c.name}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* LANGUAGE DROPDOWN */}
        <div class="nav-item-dropdown" id="language-dropdown">
          <button 
            class="nav-dropdown-toggle" 
            aria-haspopup="true" 
            aria-expanded="false"
            aria-label="Select Language"
          >
            <span>🌐 Language</span>
            <span class="dropdown-chevron" aria-hidden="true">▼</span>
          </button>
          <ul class="nav-dropdown-menu" role="menu" aria-label="Languages">
            {allLanguageItems.map((item) => (
              <li role="none">
                <a 
                  href={item.href}
                  role="menuitem"
                  class={item.isActive ? 'active-lang' : ''}
                >
                  <span class="lang-name">{item.nativeName}</span>
                  {item.isActive && <span class="lang-check" aria-hidden="true">✓</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <a href="/blog/" class={currentPath === '/blog/' || currentPath.startsWith('/blog/') ? 'active' : ''}>{localizeLabel('/blog/', 'Blog')}</a>
        <a href="/about-us/" class={currentPath === '/about-us/' || currentPath.startsWith('/about-us/') ? 'active' : ''}>{localizeLabel('/about-us/', 'About')}</a>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button type="button" class="nav-search-btn" aria-label="Search tools (Cmd+K)" onclick="window.openCmdPalette ? window.openCmdPalette() : (window.location.href='/tools/')">
          <span>🔍</span>
          <span class="search-text-label">Search</span>
          <kbd class="nav-kbd">⌘K</kbd>
        </button>
        <button class="mobile-toggle" id="mobile-toggle" aria-label={isSpanish ? 'Abrir menú' : 'Toggle menu'} aria-expanded="false">☰</button>
      </div>
    </div>
  </nav>

  <main id="main-content">
    <slot />
  </main>

  <!-- ENTERPRISE GLOBAL FOOTER (PHASE 4 DOMINATION) -->
  <footer class="footer" aria-label="Site footer">
    <div class="container">
      {/* BRAND & TRUST ROW */}
      <div class="footer-top-brand">
        <div style="max-width: 500px;">
          <a href="/" class="nav-logo" style="font-size: 1.5rem; margin-bottom: 8px; display: inline-flex; align-items: center; gap: 8px;">
            <span class="logo-icon">⚡</span>
            {siteConfig.name}
          </a>
          <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0; line-height: 1.5;">
            {isSpanish
              ? 'TapToGen ofrece 430+ generadores online gratuitos para nombres, texto, SEO y negocios. Procesamiento 100% en navegador local sin registro ni seguimiento de datos.'
              : 'TapToGen is the ultimate free discovery hub for 430+ browser-based generator tools. Fast, private, and 100% client-side with zero account requirements.'}
          </p>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <div class="footer-trust-badge privacy">
            <span>🔒</span>
            <span>100% Client-Side Privacy</span>
          </div>
          <div class="footer-trust-badge speed">
            <span>⚡</span>
            <span>< 1ms Instant Output</span>
          </div>
          <div class="footer-trust-badge free">
            <span>🎁</span>
            <span>Free Forever · No Signup</span>
          </div>
        </div>
      </div>

      {/* 5-COLUMN MAIN LINKING GRID */}
      <div class="footer-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px;">
        {/* COL 1: ALL 12 CATEGORIES */}
        <div class="footer-col">
          <h4>{isSpanish ? 'Categorías' : 'Categories'}</h4>
          {categories.map((c) => (
            <a href={`/categories/${c.slug}/`}>
              <span style="margin-right: 6px;">{c.icon}</span>
              <span>{c.name}</span>
            </a>
          ))}
        </div>

        {/* COL 2: POPULAR GENERATORS */}
        <div class="footer-col">
          <h4>{isSpanish ? 'Herramientas Populares' : 'Popular Generators'}</h4>
          {footerNav.popular.map(item => (
            <a href={item.href}>{localizeLabel(item.href, item.label)}</a>
          ))}
        </div>

        {/* COL 3: DISCOVERY HUBS */}
        <div class="footer-col">
          <h4>{isSpanish ? 'Hubs de Descubrimiento' : 'Discovery Hubs'}</h4>
          <a href="/tools/name-generators/">🏷️ Name Generators Hub</a>
          <a href="/tools/text-generators/">✨ Text Style Hub</a>
          <a href="/tools/writing-generators/">✍️ AI Writing Hub</a>
          <a href="/tools/seo-generators/">🚀 SEO & Tags Hub</a>
          <a href="/tools/business-generators/">💼 Business Hub</a>
          <a href="/tools/creative-generators/">🎮 Creative & Story Hub</a>
        </div>

        {/* COL 4: UNIVERSAL 19 LANGUAGES */}
        <div class="footer-col">
          <h4>{isSpanish ? 'Idiomas' : 'Languages'}</h4>
          <div style="max-height: 220px; overflow-y: auto; padding-right: 4px;">
            {allLanguageItems.map((item) => (
              <a href={item.href} style="display: flex; justify-content: space-between; align-items: center; font-size: 0.84rem;">
                <span>{item.nativeName}</span>
                {item.isActive && <span style="font-size: 0.75rem; color: var(--color-accent-2);">✓</span>}
              </a>
            ))}
          </div>
        </div>

        {/* COL 5: COMPANY & TRUST RESOURCES */}
        <div class="footer-col">
          <h4>{isSpanish ? 'Empresa y Recursos' : 'Company & Trust'}</h4>
          {footerNav.legal.map(item => (
            <a href={item.href}>{localizeLabel(item.href, item.label)}</a>
          ))}
          <a href="/sitemap-index.xml">🗺️ Sitemap Index</a>
          <a href="/manifest.webmanifest">📱 Web App Manifest</a>
        </div>
      </div>

      {/* FOOTER BOTTOM BAR */}
      <div class="footer-bottom" style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--color-text-secondary);">
        <span>&copy; {new Date().getFullYear()} TapToGen.com — {isSpanish ? 'Todos los derechos reservados. WCAG 2.2 AA Cumplido.' : 'All rights reserved. WCAG 2.2 AA Compliant.'}</span>
        <span>{isSpanish ? 'Generadores online diseñados para creadores y profesionales' : 'Built with ❤️ for creators, marketers & builders everywhere'}</span>
      </div>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('scrolled', window.scrollY > 40);
    });

    // Dropdowns (Language & Categories) Mobile & Focus handling
    document.querySelectorAll('.nav-item-dropdown').forEach((dropdown) => {
      const toggleBtn = dropdown.querySelector('.nav-dropdown-toggle');
      toggleBtn?.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
          e.preventDefault();
          const isOpen = dropdown.classList.toggle('mobile-open');
          toggleBtn.setAttribute('aria-expanded', String(isOpen));
        }
      });
    });

    const toggle = document.getElementById('mobile-toggle');
    const links = document.getElementById('nav-links');
    toggle?.addEventListener('click', () => {
      const isOpen = links?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    links?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        links.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    // Global Keyboard Accessibility: Close dropdowns and drawer on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.nav-item-dropdown').forEach(d => {
          d.classList.remove('mobile-open');
          d.querySelector('.nav-dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        });
        if (links?.classList.contains('open')) {
          links.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      }
    });

    const initAnimations = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('animate-in'); observer.unobserve(e.target); }});
      }, { threshold: 0.1 });
      document.querySelectorAll('.tool-card, .feature-card, .category-card, .step-card, .faq-item').forEach(el => observer.observe(el));
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(initAnimations);
    } else {
      setTimeout(initAnimations, 200);
    }
  </script>
  <CommandPalette />
  <PwaInstallBanner />
  <script is:inline src="/sw-register.js"></script>
</body>
</html>

