---
import type { ComparisonBlock } from '@/lib/helpful-content-engine';

interface Props {
  comparison: ComparisonBlock;
}

const { comparison } = Astro.props;
---

{comparison && (
  <section class="content-card comparison-section" style="margin-top: 2rem; margin-bottom: 2rem;">
    <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-text-primary);">
      {comparison.title}
    </h2>
    <p style="margin-bottom: 1.25rem; color: rgba(255, 255, 255, 0.7); font-size: 0.95rem;">
      {comparison.subtitle}
    </p>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
        <thead>
          <tr style="border-bottom: 2px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.02);">
            <th style="padding: 0.75rem 1rem; color: #818cf8;">Feature / Criterion</th>
            <th style="padding: 0.75rem 1rem; color: #34d399;">{comparison.methodA}</th>
            <th style="padding: 0.75rem 1rem; color: #94a3b8;">{comparison.methodB}</th>
          </tr>
        </thead>
        <tbody>
          {comparison.comparisonRows.map(row => (
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
              <td style="padding: 0.75rem 1rem; font-weight: 600; color: #e2e8f0;">{row.feature}</td>
              <td style="padding: 0.75rem 1rem; color: rgba(255, 255, 255, 0.85);">{row.methodAVal}</td>
              <td style="padding: 0.75rem 1rem; color: rgba(255, 255, 255, 0.65);">{row.methodBVal}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="margin-top: 1rem; padding: 0.875rem 1rem; border-radius: 6px; background: rgba(52, 211, 153, 0.05); border: 1px solid rgba(52, 211, 153, 0.15); font-size: 0.875rem; color: #a7f3d0;">
      <strong>Verdict:</strong> {comparison.verdict}
    </div>
  </section>
)}
