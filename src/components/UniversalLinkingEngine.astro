---
import { getUniversalLinkingBlocks, type UniversalLinkingData } from '../lib/universal-internal-linking-engine';
import type { SupportedLanguageCode } from '../data/localization';

interface Props {
  toolSlug: string;
  lang?: string;
}

const { toolSlug, lang = 'en' } = Astro.props;

const data: UniversalLinkingData = getUniversalLinkingBlocks(toolSlug, lang as SupportedLanguageCode);
const {
  relatedTools,
  sameCategoryTools,
  parentHub,
  popularTools,
  recentlyUpdatedTools,
  peopleAlsoUse,
  continueExploring,
  topCollections
} = data;

const isSpanish = lang === 'es';
const headings = {
  related: isSpanish ? 'Herramientas Relacionadas' : 'Related Tools',
  sameCategory: isSpanish ? 'Más en esta Categoría' : 'More in this Category',
  parentHub: isSpanish ? 'Hub Principal y Categoría' : 'Parent Category & Discovery Hub',
  popular: isSpanish ? 'Herramientas Populares' : 'Popular Generators',
  recentlyUpdated: isSpanish ? 'Destacadas y Recientes' : 'Featured & Trending Tools',
  peopleAlsoUse: isSpanish ? 'Recomendaciones por Intención' : 'People Also Use',
  continueExploring: isSpanish ? 'Explora Otras Categorías' : 'Continue Exploring',
  topCollections: isSpanish ? 'Colecciones Principales' : 'Top Collections',
};
---

<section class="universal-linking-engine" aria-label="Internal discovery and related tools">
  {/* BLOCK 3: PARENT HUB & CATEGORY CARD */}
  {parentHub && (
    <div class="content-card parent-hub-card" style="margin-bottom: 24px; border: 1px solid var(--color-accent-1); background: rgba(108,92,231,0.04); padding: 24px; border-radius: 12px;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <span style="font-size: 2.2rem; background: var(--color-bg-secondary); padding: 12px; border-radius: 12px; border: 1px solid var(--color-border);">{parentHub.categoryIcon}</span>
          <div>
            <span class="section-badge" style="margin-bottom: 4px;">{headings.parentHub}</span>
            <h2 style="font-size: 1.4rem; margin: 4px 0 0 0; color: var(--color-text-primary);">{parentHub.categoryName}</h2>
          </div>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href={parentHub.categoryUrl} class="btn btn-outline" style="padding: 8px 16px; font-size: 0.88rem;">
            {isSpanish ? `Ver Categoría ${parentHub.categoryName}` : `Browse ${parentHub.categoryName}`} &rarr;
          </a>
          {parentHub.hubUrl && (
            <a href={parentHub.hubUrl} class="btn btn-primary" style="padding: 8px 16px; font-size: 0.88rem;">
              {parentHub.hubTitle || (isSpanish ? 'Explorar Hub' : 'Explore Hub')} &rarr;
            </a>
          )}
        </div>
      </div>
    </div>
  )}

  {/* BLOCK 1: RELATED TOOLS */}
  {relatedTools && relatedTools.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.related}</h2>
      <div class="linking-grid">
        {relatedTools.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* BLOCK 2: SAME CATEGORY TOOLS */}
  {sameCategoryTools && sameCategoryTools.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.sameCategory}</h2>
      <div class="linking-grid">
        {sameCategoryTools.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* BLOCK 6: PEOPLE ALSO USE */}
  {peopleAlsoUse && peopleAlsoUse.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.peopleAlsoUse}</h2>
      <div class="linking-grid">
        {peopleAlsoUse.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* BLOCK 7: CONTINUE EXPLORING (CROSS-CATEGORY) */}
  {continueExploring && continueExploring.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.continueExploring}</h2>
      <div class="linking-grid">
        {continueExploring.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* BLOCK 4 & 5: POPULAR & RECENTLY UPDATED */}
  {popularTools && popularTools.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.popular}</h2>
      <div class="linking-grid">
        {popularTools.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {recentlyUpdatedTools && recentlyUpdatedTools.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.recentlyUpdated}</h2>
      <div class="linking-grid">
        {recentlyUpdatedTools.map((t) => (
          <a href={t.url} class="tool-card linking-card">
            <div class="tool-icon">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.tagline}</p>
            <span class="tool-tag">{t.category}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* BLOCK 8: TOP COLLECTIONS */}
  {topCollections && topCollections.length > 0 && (
    <div class="content-card linking-block" style="margin-bottom: 24px;">
      <h2>{headings.topCollections}</h2>
      <div class="category-grid">
        {topCollections.map((c) => (
          <a href={c.url} class="category-card">
            <span class="cat-icon">{c.icon}</span>
            <h3>{c.title}</h3>
            <p>{c.description}</p>
            <span style="font-size: 0.75rem; color: var(--color-accent-2); margin-top: 6px; font-weight: 600;">{c.toolCount} Tools Available</span>
          </a>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .universal-linking-engine {
    margin-top: 40px;
  }
  .linking-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .linking-card {
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .linking-card:hover,
  .linking-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(108, 92, 231, 0.2);
    border-color: var(--color-primary);
    outline: none;
  }
</style>
