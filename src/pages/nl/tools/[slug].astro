---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import PresetExamplesSection from '@/components/PresetExamplesSection.astro';
import ExpertInsightSection from '@/components/ExpertInsightSection.astro';
import ComparisonSection from '@/components/ComparisonSection.astro';
import {
  getPresetsForTool,
  getExpertInsightsForTool,
  getComparisonBlockForTool
} from '@/lib/helpful-content-engine';
import MobileActionBar from '@/components/MobileActionBar.astro';
import { getRelatedTools, getToolBySlug, type Tool } from '@/data/tools';
import { noindexToolSlugs, pass20ControlMap } from '@/data/tool-page-data';
import { toolHubs } from '@/data/hubs';
import {
  createLocalizedFaqItems,
  createLocalizedGuide,
  getLanguageSwitchRoute,
  getLocalizedToolByCanonicalId,
  getLocalizedToolBySlug,
  getLocalizedPageCopy,
  getLocalizedSafetyNote,
  getLocalizedHubCopy,
  getLocalizedUiLabel,
  getToolLanguageAlternates,
  getSupportedLanguage,
  localizedPilotLanguages,
  dutchPilotTools,
} from '@/data/localization';

export const prerender = true;

export function getStaticPaths() {
  return dutchPilotTools
    .filter((entry) => !noindexToolSlugs.has(entry.canonicalToolId))
    .map((entry) => {
      const tool = getToolBySlug(entry.canonicalToolId);
      if (!tool) return null;
      return {
        params: { slug: entry.localizedSlug },
        props: { tool, localized: entry },
      };
    })
    .filter((path): path is { params: { slug: string }; props: { tool: Tool; localized: (typeof dutchPilotTools)[number] } } => path !== null);
}

interface Props {
  tool: Tool;
  localized: (typeof dutchPilotTools)[number];
}

const { tool, localized } = Astro.props;
const presets = getPresetsForTool(tool);
const expertInsight = getExpertInsightsForTool(tool);
const comparisonBlock = getComparisonBlockForTool(tool);
const slug = tool.slug;

const resolvedLocalization = getLocalizedToolBySlug(Astro.params.slug || '', 'nl');
if (!resolvedLocalization || resolvedLocalization.canonicalToolId !== slug) {
  return Astro.redirect(getLanguageSwitchRoute(slug, 'en'));
}

const related = getRelatedTools(slug, 8).filter((item) => !noindexToolSlugs.has(item.slug)).slice(0, 4);
const matchingHub = toolHubs.find((hub) => hub.slug === tool.categorySlug || hub.categorySlugs.includes(tool.categorySlug));
const nextStepHubs = toolHubs
  .filter((hub) => hub.slug !== matchingHub?.slug && (matchingHub?.relatedHubSlugs.includes(hub.slug) || hub.relatedHubSlugs.includes(matchingHub?.slug || '')))
  .slice(0, 3);

const faqItems = createLocalizedFaqItems(localized);
const guideCopy = createLocalizedGuide(tool, localized);
const copy = getLocalizedPageCopy(localized);
const safetyNote = getLocalizedSafetyNote(localized);
const englishRoute = getLanguageSwitchRoute(slug, 'en');
const localizedRoute = getLanguageSwitchRoute(slug, 'nl');
const alternates = getToolLanguageAlternates(slug);

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": copy.h1,
  "url": `https://taptogen.com${localizedRoute}`,
  "description": copy.metaDescription,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any",
  "author": {
    "@type": "Organization",
    "name": "TapToGen Editorial Team",
    "url": "https://taptogen.com/about-us/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "TapToGen",
    "url": "https://taptogen.com/"
  },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "nl"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://taptogen.com/nl/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://taptogen.com/nl/tools/" },
    { "@type": "ListItem", "position": 3, "name": copy.h1, "item": `https://taptogen.com${localizedRoute}` }]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "nl",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const pass20Controls = pass20ControlMap[slug];
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonical={localizedRoute}
  schema={[toolSchema, breadcrumbSchema, faqSchema]}
  noindex={false}
  lang="nl"
  dir="ltr"
  alternates={alternates}
>
  <section class="tool-page">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/tools/">Tools</a><span class="sep">/</span>
        <a href={`/tools/${tool.slug}/`}>Engelse Versie</a><span class="sep">/</span>
        <span>{copy.h1}</span>
      </div>

      <div class="tool-page-header premium-tool-header">
        <span class="section-badge tool-category-badge">{tool.icon} {getLocalizedUiLabel(tool.category, 'nl')}</span>
        <h1>{copy.h1}</h1>
        <p>{copy.intro}</p>
        <nav class="language-switcher" aria-label="Taalkeuze">
          <a href={englishRoute} hreflang="en" lang="en">English</a>
          {localizedPilotLanguages.map((language) => (
            <a class={language === 'nl' ? 'active' : ''} href={getLanguageSwitchRoute(slug, language)} hreflang={language} lang={language}>{getSupportedLanguage(language).nativeName}</a>
          ))}
        </nav>
        <div class="tool-benefits" aria-label="Tool Voordelen">
          <span>Gratis</span>
          <span>Direct</span>
          <span>Zonder Registratie</span>
          <span>Privé in Browser</span>
        </div>
      </div>

      <div class="tool-workspace premium-tool-workspace" id="tool-workspace" data-tool={tool.slug} data-type={tool.generatorType} data-format={tool.outputFormat || 'text'}>
        <div id="generator-ui">
          <div class="workspace-panel input-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-kicker">Invoer</span>
                <h2>Resultaat aanpassen</h2>
              </div>
              <span class="generator-type-pill">{getLocalizedUiLabel(tool.generatorType.replace('-', ' '), 'nl')}</span>
            </div>

            {tool.toolOptions && tool.toolOptions.length > 0 && (
              <div class="tool-options-panel">
                {tool.toolOptions.map(opt => (
                  <div class="tool-option">
                    <label for={opt.id}>{getLocalizedUiLabel(opt.label, 'nl')}</label>
                    {opt.type === 'select' && (
                      <select id={opt.id} class="tool-select">
                        {opt.options?.map(o => (
                          <option value={o.value} selected={o.value === opt.default}>{getLocalizedUiLabel(o.label, 'nl')}</option>
                        ))}
                      </select>
                    )}
                    {opt.type === 'number' && (
                      <input type="number" id={opt.id} class="tool-number" value={typeof opt.default === 'number' || typeof opt.default === 'string' ? opt.default : undefined} min={opt.min} max={opt.max} />
                    )}
                    {opt.type === 'checkbox' && (
                      <div class="checkbox-option">
                        <input type="checkbox" id={opt.id} class="tool-checkbox" checked={!!opt.default} />
                        <span>Ingeschakeld</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}

            {pass20Controls && (
              <div class="tool-options-panel">
                <div class="tool-option">
                  <label for={pass20Controls.modeId}>{getLocalizedUiLabel(pass20Controls.modeLabel, 'nl')}</label>
                  <select id={pass20Controls.modeId} class="tool-select">
                    {pass20Controls.modes.map(option => (
                      <option value={option.value}>{getLocalizedUiLabel(option.label, 'nl')}</option>
                    ))}
                  </select>
                </div>
                {pass20Controls.toneId && (
                  <div class="tool-option">
                    <label for={pass20Controls.toneId}>Toon</label>
                    <select id={pass20Controls.toneId} class="tool-select">
                      <option value="balanced">Gebalanceerd</option>
                      <option value="polished">Netjes</option>
                      <option value="creative">Creatief</option>
                      <option value="friendly">Vriendelijk</option>
                    </select>
                  </div>
                )}
                {pass20Controls.countId && (
                  <div class="tool-option">
                    <label for={pass20Controls.countId}>Aantal</label>
                    <input type="number" id={pass20Controls.countId} class="tool-number" value={pass20Controls.countDefault} min={pass20Controls.countMin} max={pass20Controls.countMax} />
                  </div>
                )}
              </div>
            )}

            <label class="input-label" for="tool-input">Prompt, Trefwoord, Tekst of Details</label>
            <textarea class="tool-input" id="tool-input" placeholder="Voer een trefwoord, prompt of tekst in om deze generator aan te passen..." rows="4"></textarea>
            <div class="example-chip-row" aria-label="Voorbeelden">
              <button type="button" class="example-chip" data-example={copy.primaryKeyword}>{copy.primaryKeyword}</button>
              {copy.faqTopics.slice(0, 2).map(keyword => (
                <button type="button" class="example-chip" data-example={keyword}>{keyword}</button>
              ))}
            </div>
            <div class="tool-controls premium-controls">
              <button class="btn btn-primary" id="generate-btn">Genereren</button>
              <button class="btn btn-outline" id="example-btn">Voorbeeld gebruiken</button>
              <button class="btn btn-ghost" id="reset-btn">Wissen</button>
              <button class="btn btn-ghost" id="regenerate-btn">Opnieuw generieren</button>
            </div>
          </div>

          <div class="workspace-panel output-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-kicker">Uitvoer</span>
                <h2>Jouw Resultaten</h2>
              </div>
              <button class="copy-btn copy-all-btn" id="copy-btn">Alles kopiëren</button>
            </div>
            <div class="tool-output premium-output empty" id="tool-output">Jouw resultaten verschijnen hier.</div>
          </div>
        </div>
      </div>

      {safetyNote && (
        <div class="tool-disclaimer" style="margin-top: 15px; padding: 15px; background: rgba(255, 193, 7, 0.1); border-left: 4px solid #ffc107; border-radius: 4px; font-size: 0.9rem; color: #b8860b;">
          <strong>Opmerking:</strong> {safetyNote}
        </div>
      )}

      <div class="content-section premium-content-section">
        <section class="content-card intro-card">
          <h2>Wat is {copy.h1}?</h2>
          <div class="featured-snippet-box" style="padding: 16px; background: rgba(99, 102, 241, 0.08); border-left: 4px solid var(--color-primary, #6366f1); border-radius: 8px; margin-bottom: 16px;">
            <p style="margin: 0; font-size: 1.05rem; line-height: 1.6; font-weight: 500; color: var(--color-text-primary);">
              <strong>{copy.h1}</strong> is een gratis online tool voor het direct genereren van geoptimaliseerde {copy.primaryKeyword} resultaten. Het biedt gestructureerde concepten direct in jouw browser zonder registratie, gegevensopslag of software-installatie.
            </p>
          </div>
          <p>{copy.metaDescription}</p>
          <p>{copy.intro}</p>
        </section>

        <PresetExamplesSection presets={presets} toolName={tool.name} />
        <ExpertInsightSection insight={expertInsight} toolName={tool.name} />
        <ComparisonSection comparison={comparisonBlock} />

        <AuthorByline />

        <section class="content-card">
          <h2>Belangrijkste Voordelen</h2>
          <ul>
            <li><strong>100% Gratis</strong> - Geen abonnementen, geen extra kosten en geen creditcard vereist.</li>
            <li><strong>Lokale Privacy</strong> - Alle verwerking vindt lokaal plaats in jouw browser. Jouw gegevens zijn veilig.</li>
            <li><strong>Directe Resultaten</strong> - Ontvang geoptimaliseerde suggesties in enkele milliseconden.</li>
            <li><strong>Zonder Registratie</strong> - Gebruik de tool direct zonder account of aanmelding.</li>
          </ul>
        </section>

        <section class="content-card">
          <h2>Functies van {copy.h1}</h2>
          <ul>
            <li><strong>Interactieve Instellingen</strong> - Pas toon, aantal en structuur direct aan via het bedieningspaneel.</li>
            <li><strong>Eén-Klik Kopiëren</strong> - Kopieer afzonderlijke regels of alle resultaten direct naar het klembord.</li>
            <li><strong>Schone Opmaak</strong> - Geeft direct bruikbare tekst zonder onnodige opmaak.</li>
          </ul>
        </section>

        <section class="content-card">
          <h2>Hoe gebruik je {copy.h1}?</h2>
          <ol>
            {guideCopy.howTo.map(step => <li>{step}</li>)}
          </ol>
        </section>

        <section class="content-card">
          <h2>Tips voor Betere Resultaten</h2>
          <ul>
            {guideCopy.tips.map(tip => <li><strong>{tip.title}</strong> - {tip.body}</li>)}
          </ul>
        </section>

        <section class="content-card">
          <h2>Waarom TapToGen gebruiken?</h2>
          <ul>
            <li><strong>Directe Resultaten</strong> - Maak ideeën rechtstreeks in jouw browser.</li>
            <li><strong>Gratis</strong> - Zonder registratie en zonder verborgen kosten.</li>
            <li><strong>Praktische Privacy</strong> - Het proces werkt lokaal zonder accountvereisten.</li>
            <li><strong>Makkelijk te controleren</strong> - Kopieer, vergelijk en pas resultaten aan voor gebruik.</li>
          </ul>
        </section>

        <section class="content-card">
          <h2>Veelgestelde Vragen</h2>
          <div class="faq-list">
            {faqItems.map(faq => (
              <div class="faq-item">
                <button class="faq-question" aria-expanded="false">
                  <span>{faq.q}</span>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer"><p>{faq.a}</p></div>
              </div>
            ))}
          </div>
        </section>

        {related.length > 0 && (
          <section class="content-card related-card">
            <h2>Gerelateerde Tools</h2>
            <div class="tools-grid related-tools-grid">
              {related.map(r => (
                <a href={getLanguageSwitchRoute(r.slug, 'nl')} class="tool-card">
                  <div class="tool-icon">{r.icon}</div>
                  <h3>{getLocalizedToolByCanonicalId(r.slug, 'nl') ? getLocalizedPageCopy(getLocalizedToolByCanonicalId(r.slug, 'nl')!).h1 : r.name}</h3>
                  <p>{getLocalizedToolByCanonicalId(r.slug, 'nl') ? getLocalizedPageCopy(getLocalizedToolByCanonicalId(r.slug, 'nl')!).intro : r.tagline}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        {(matchingHub || nextStepHubs.length > 0) && (
          <section class="content-card">
            <h2>Ontdek meer TapToGen-tools</h2>
            <p>Deze links leiden naar actieve, indexeerbare tools.</p>
            <div class="category-grid">
              {matchingHub && (
                <a href={`/tools/${matchingHub.slug}/`} class="category-card">
                  <span class="cat-icon">#</span>
                  <h3>{getLocalizedHubCopy(matchingHub.slug, matchingHub.h1, matchingHub.description, 'nl').title}</h3>
                  <p>{getLocalizedHubCopy(matchingHub.slug, matchingHub.h1, matchingHub.description, 'nl').description}</p>
                </a>
              )}
              {nextStepHubs.map((hub) => (
                <a href={`/tools/${hub.slug}/`} class="category-card">
                  <span class="cat-icon">#</span>
                  <h3>{getLocalizedHubCopy(hub.slug, hub.h1, hub.description, 'nl').title}</h3>
                  <p>{getLocalizedHubCopy(hub.slug, hub.h1, hub.description, 'nl').description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>

  <MobileActionBar isFr={false} />

  <script>
    import '@/scripts/tool-workspace';
  </script>
</BaseLayout>
