---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { blogPosts, getBlogPostBySlug, getRelatedBlogPosts } from '@/data/blog-posts';
import { getToolBySlug } from '@/data/tools';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = getBlogPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/404/');
}

const relatedPosts = getRelatedBlogPosts(post.slug, 3);
const relatedTools = post.relatedToolSlugs
  .map((toolSlug) => getToolBySlug(toolSlug))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': post.title,
  'description': post.metaDescription,
  'image': 'https://taptogen.com/og-default.png',
  'datePublished': post.publishDate,
  'dateModified': post.updateDate,
  'author': {
    '@type': 'Organization',
    'name': post.author.name,
    'jobTitle': post.author.role,
    'url': 'https://taptogen.com/about-us/'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'TapToGen',
    'url': 'https://taptogen.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://taptogen.com/favicon.png'
    }
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://taptogen.com/blog/${post.slug}/`
  }
};
---

<BaseLayout
  title={`${post.seoTitle} — TapToGen Blog`}
  description={post.metaDescription}
  canonical={`/blog/${post.slug}/`}
  schema={[blogPostingSchema]}
>
  <!-- ARTICLE HERO SECTION -->
  <section class="page-hero" style="padding-bottom: 40px;">
    <div class="container" style="max-width: 900px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">›</span>
        <a href="/blog/">Blog</a><span class="sep">›</span>
        <span>{post.category}</span>
      </nav>
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 16px;">
        <span class="section-badge">{post.icon} {post.category}</span>
      </div>
      <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.25; margin-bottom: 20px;">
        {post.title}
      </h1>
      
      <!-- EEAT AUTHOR META BAR -->
      <div class="author-meta-bar" style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 16px; margin-top: 24px; font-size: 0.9rem; color: var(--color-text-secondary);">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 1.4rem;">{post.author.avatar}</span>
          <div>
            <strong style="color: var(--color-text-primary); display: block; line-height: 1.2;">{post.author.name}</strong>
            <span style="font-size: 0.78rem; color: var(--color-text-muted);">{post.author.role}</span>
          </div>
        </div>
        <span style="color: var(--color-border);">•</span>
        <span>📅 Published {post.publishDate}</span>
        <span style="color: var(--color-border);">•</span>
        <span>🔄 Updated {post.updateDate}</span>
        <span style="color: var(--color-border);">•</span>
        <span>⏱️ {post.readTime}</span>
      </div>
    </div>
  </section>

  <!-- MAIN ARTICLE CONTAINER -->
  <div class="container" style="max-width: 1100px; padding-bottom: 80px;">
    <div class="article-layout">
      <!-- TABLE OF CONTENTS (MOBILE / TABLET BOX) -->
      {post.tableOfContents && post.tableOfContents.length > 0 && (
        <div class="toc-box-mobile">
          <div class="toc-title">📌 Table of Contents</div>
          <ul>
            {post.tableOfContents.map((toc) => (
              <li><a href={`#${toc.id}`}>{toc.title}</a></li>
            ))}
          </ul>
        </div>
      )}

      <!-- ARTICLE BODY -->
      <article class="content-section article-body" style="max-width: 800px; margin: 0 auto;">
        <Fragment set:html={post.content} />

        <!-- EEAT AUTHOR BOX FOOTER -->
        <div class="author-bio-box" style="margin-top: 60px; padding: 28px; background: rgba(108, 92, 231, 0.06); border: 1px solid var(--color-border); border-radius: 16px; display: flex; gap: 20px; align-items: flex-start;">
          <span style="font-size: 2.8rem; line-height: 1;">{post.author.avatar}</span>
          <div>
            <h4 style="margin: 0 0 6px 0; font-size: 1.1rem; color: var(--color-text-primary);">Written by {post.author.name}</h4>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary); margin-bottom: 12px; line-height: 1.6;">
              {post.author.role} at TapToGen. Dedicated to providing research-backed guides, privacy standards, and practical workflows for digital creators, writers, and developers.
            </p>
            <a href="/about-us/" style="font-size: 0.82rem; color: var(--color-accent-2); font-weight: 600; text-decoration: underline;">Read Editorial Standards & About TapToGen →</a>
          </div>
        </div>

        <!-- RELATED GENERATOR TOOLS WIDGET -->
        {relatedTools.length > 0 && (
          <div class="related-tools-section" style="margin-top: 50px; padding-top: 40px; border-top: 1px solid var(--color-border);">
            <h3 style="margin-top: 0; font-size: 1.3rem; margin-bottom: 20px;">⚡ Try Free Related Generators</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px;">
              {relatedTools.map((tool) => (
                <a href={`/tools/${tool.slug}/`} class="tool-card-mini" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; text-decoration: none; transition: var(--transition);">
                  <span style="font-size: 1.8rem;">{tool.icon}</span>
                  <div>
                    <strong style="display: block; font-size: 0.92rem; color: var(--color-text-primary);">{tool.name}</strong>
                    <span style="font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.3; display: block; margin-top: 2px;">{tool.tagline}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    </div>

    <!-- RELATED ARTICLES FOOTER GRID -->
    {relatedPosts.length > 0 && (
      <section style="margin-top: 80px; padding-top: 50px; border-top: 1px solid var(--color-border);">
        <div style="text-align: center; margin-bottom: 32px;">
          <span class="section-badge">📚 Keep Reading</span>
          <h2 style="font-size: 1.6rem; margin-top: 8px;">Related Practical Guides</h2>
        </div>
        <div class="tools-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
          {relatedPosts.map((rel) => (
            <article class="tool-card" style="display: flex; flex-direction: column; gap: 12px; padding: 24px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.4rem;">{rel.icon}</span>
                <span class="tool-tag" style="font-size: 0.75rem;">{rel.category}</span>
              </div>
              <h3 style="font-size: 1.05rem; font-weight: 700; line-height: 1.4; margin: 0;">
                <a href={`/blog/${rel.slug}/`} style="color: inherit; text-decoration: none;">{rel.title}</a>
              </h3>
              <p style="font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.6; flex: 1; margin: 0;">{rel.excerpt}</p>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 12px;">
                <span style="font-size: 0.78rem; color: var(--color-text-muted);">{rel.readTime}</span>
                <a href={`/blog/${rel.slug}/`} style="font-size: 0.85rem; color: var(--color-accent-1); font-weight: 600;">Read Guide →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>

  <style>
    .article-body h2 {
      scroll-margin-top: 100px;
    }
    .toc-box-mobile {
      margin: 0 auto 40px auto;
      max-width: 800px;
      padding: 24px;
      background: rgba(15, 15, 35, 0.7);
      border: 1px solid var(--color-border);
      border-radius: 14px;
    }
    .toc-title {
      font-weight: 700;
      font-size: 1.05rem;
      margin-bottom: 12px;
      color: var(--color-text-primary);
    }
    .toc-box-mobile ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-box-mobile li {
      margin-bottom: 8px;
    }
    .toc-box-mobile a {
      color: var(--color-accent-2);
      font-size: 0.92rem;
      text-decoration: none;
      transition: var(--transition);
    }
    .toc-box-mobile a:hover {
      color: var(--color-accent-1);
      text-decoration: underline;
    }
    .callout {
      padding: 20px 24px;
      margin: 28px 0;
      border-radius: 12px;
      border-left: 4px solid var(--color-accent-1);
      background: rgba(108, 92, 231, 0.08);
    }
    .callout-title {
      font-weight: 700;
      margin-bottom: 8px;
      font-size: 1rem;
      color: var(--color-text-primary);
    }
    .callout-warning {
      border-left-color: #f59e0b;
      background: rgba(245, 158, 11, 0.08);
    }
    .callout-tip {
      border-left-color: #10b981;
      background: rgba(16, 185, 129, 0.08);
    }
    .step-card {
      padding: 20px 24px;
      margin: 20px 0;
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: 14px;
    }
    .step-number {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--color-accent-2);
      letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .step-card h3 {
      margin: 0 0 8px 0;
      font-size: 1.1rem;
    }
    .tool-card-mini:hover {
      border-color: var(--color-accent-1);
      transform: translateY(-2px);
    }
    .faq-accordion h3 {
      font-size: 1.05rem;
      margin-top: 24px;
      margin-bottom: 8px;
      color: var(--color-text-primary);
    }
    .faq-accordion p {
      font-size: 0.95rem;
      margin-bottom: 16px;
    }
  </style>
</BaseLayout>
