---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { blogPosts } from '@/data/blog-posts';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'TapToGen Blog',
  'url': 'https://taptogen.com/blog/',
  'description': 'Practical guides, technical strategies, and tutorials about generator tools, naming, SEO, AI writing, and digital privacy.',
  'publisher': {
    '@type': 'Organization',
    'name': 'TapToGen',
    'url': 'https://taptogen.com/'
  }
};

const categories = Array.from(new Set(blogPosts.map(p => p.category)));
---

<BaseLayout
  title="Blog — TapToGen | Generator Tool Guides, SEO & Brand Strategies"
  description="Explore 10 comprehensive guides covering fancy text formatting, business name generation, SEO meta tags, AI prompt engineering, client-side password security, and YouTube SEO."
  canonical="/blog/"
  schema={[blogSchema]}
>
  <!-- HERO SECTION -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a><span class="sep">›</span><span>Blog</span></div>
      <span class="section-badge">📖 Guides & Research</span>
      <h1>TapToGen <span class="gradient-text">Blog & Guides</span></h1>
      <p>Research-backed guides, technical strategies, and tutorials for generator tools, naming, SEO, and digital creativity</p>
    </div>
  </section>

  <!-- BLOG GRID SECTION -->
  <section class="tools-section" style="padding-top: 0; padding-bottom: 80px;">
    <div class="container">
      <!-- CATEGORY BADGES -->
      <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px;">
        <span class="tool-tag" style="background: var(--gradient-main); color: #fff; padding: 6px 14px; border-radius: 100px; font-weight: 600;">All ({blogPosts.length})</span>
        {categories.map(cat => (
          <span class="tool-tag" style="padding: 6px 14px; border-radius: 100px; font-weight: 500;">{cat}</span>
        ))}
      </div>

      <!-- ARTICLES GRID -->
      <div class="tools-grid" style="grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;">
        {blogPosts.map((article) => (
          <article class="tool-card blog-card" style="display: flex; flex-direction: column; gap: 14px; padding: 28px; position: relative;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 1.8rem;">{article.icon}</span>
              <span class="tool-tag" style="font-size: 0.75rem;">{article.category}</span>
            </div>
            
            <h2 style="font-size: 1.1rem; font-weight: 700; line-height: 1.4; margin: 0;">
              <a href={`/blog/${article.slug}/`} style="color: inherit; text-decoration: none;" class="article-title-link">
                {article.title}
              </a>
            </h2>
            
            <p style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; flex: 1; margin: 0;">
              {article.excerpt}
            </p>
            
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 16px; border-top: 1px solid var(--color-border); font-size: 0.82rem; color: var(--color-text-muted);">
              <span>{article.publishDate} • {article.readTime}</span>
              <a href={`/blog/${article.slug}/`} style="color: var(--color-accent-1); font-weight: 600; text-decoration: none;">Read Guide →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blog-card {
      transition: var(--transition);
    }
    .blog-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-accent-1);
    }
    .article-title-link:hover {
      color: var(--color-accent-2) !important;
    }
  </style>
</BaseLayout>
